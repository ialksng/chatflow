# ==========================================
# ChatFlow Environment Configuration
# ==========================================

# ------------------------------------------
# Server (Backend) Configuration
# ------------------------------------------
PORT=5002
NODE_ENV=production
CLIENT_URL=https://ialksng.me

# MongoDB Database URI (Primary Database)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/chatflow?retryWrites=true&w=majority

# JWT Secret (for session token generation and verification)
JWT_SECRET=your_jwt_secret_key

# Email Service (Password Reset via SMTP / Gmail)
EMAIL_USER=ialksng@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=Alok Singh <no-reply@ialksng.me>
EMAIL_REPLY_TO=no-reply@ialksng.me

# Google OAuth (Backend Verification & OAuth 2.0 Code Flow)
GOOGLE_CLIENT_ID=510025990690-37hffq9r60gfpm68bvdmr34dn3bokior.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://ialksng.me/work/projects/chatflow/app/api/auth/google/callback

# Cloudinary (for avatar & image attachments)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Groq AI (for AI Assistant)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Twilio Network Traversal (TURN & STUN for cross-network WebRTC audio/video/draw)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# ------------------------------------------
# Client (Frontend) Configuration
# ------------------------------------------
# Base subpath where the frontend SPA is hosted
VITE_BASE_PATH=/work/projects/chatflow/app/

# REST API Base URL (defaults to /work/projects/chatflow/app/api proxied by vercel.json)
VITE_API_URL=/work/projects/chatflow/app/api

# Socket.IO Server Endpoint for real-time chat & WebRTC signaling
VITE_SOCKET_URL=https://chatflow.ialksng.me

# Google OAuth Client ID & Callback (Frontend Web Client)
VITE_GOOGLE_CLIENT_ID=510025990690-37hffq9r60gfpm68bvdmr34dn3bokior.apps.googleusercontent.com
VITE_GOOGLE_CALLBACK_URL=https://ialksng.me/work/projects/chatflow/app/api/auth/google/callback
