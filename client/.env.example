# ------------------------------------------
# Client (Vite Frontend) Environment Variables
# ------------------------------------------

# Subpath base where the frontend app is hosted
VITE_BASE_PATH=/work/projects/chatflow/app/

# REST API endpoint (relative /work/projects/chatflow/app/api proxies via vercel.json in production)
VITE_API_URL=/work/projects/chatflow/app/api

# Backend Socket.IO Server URL for chat & WebRTC audio/video calls
VITE_SOCKET_URL=https://chatflow.ialksng.me

# Google OAuth Client ID & Callback for Google Login
VITE_GOOGLE_CLIENT_ID=510025990690-37hffq9r60gfpm68bvdmr34dn3bokior.apps.googleusercontent.com
VITE_GOOGLE_CALLBACK_URL=https://ialksng.me/work/projects/chatflow/app/api/auth/google/callback
