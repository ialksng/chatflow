{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/work/projects/chatflow/app/",
      "permanent": false
    },
    {
      "source": "/work/projects/chatflow",
      "destination": "/work/projects/chatflow/app/",
      "permanent": false
    },
    {
      "source": "/work/projects/chatflow/",
      "destination": "/work/projects/chatflow/app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/work/projects/chatflow/app/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/work/projects/chatflow/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/work/projects/chatflow/app/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/work/projects/chatflow/app/",
      "destination": "/index.html"
    },
    {
      "source": "/work/projects/chatflow/app",
      "destination": "/index.html"
    },
    {
      "source": "/work/projects/chatflow/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
